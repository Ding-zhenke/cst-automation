from typing import Any, Dict, List, Optional

def circuit_capabilities(*, probe: str = "static", app: Any = None) -> Dict[str, Any]: ...

class CircuitAPI:
    def __init__(self, app: Any, *, adapter: Any = None) -> None: ...
    def capabilities(self, *, probe: str = "static") -> Dict[str, Any]: ...
    def inspect(self) -> Dict[str, Any]: ...
    def list_block_types(self) -> List[Dict[str, Any]]: ...
    def list_pins(self, block_name: str) -> List[Dict[str, Any]]: ...
    def apply(self, spec: Dict[str, Any], *, conflict: str = "error") -> Dict[str, Any]: ...
    def set_properties(self, block_name: str, properties: Dict[str, Any], *, units: Dict[str, str]) -> Dict[str, Any]: ...
    def configure_transient_task(self, task_name: str, settings: Dict[str, Any], *, create: bool = False) -> Dict[str, Any]: ...
    def configure_steady_state_task(self, task_name: str, settings: Dict[str, Any], *, create: bool = False) -> Dict[str, Any]: ...
    def configure_task_ports(self, task_name: str, ports: Dict[str, Any]) -> Dict[str, Any]: ...
    def configure_nonlinear_model(self, block_name: str, settings: Dict[str, Any], *, create: bool = False) -> Dict[str, Any]: ...
    def validate(self, *, task_name: str) -> Dict[str, Any]: ...
    def link_em(self, *, block_name: str, source: str, port_map: List[Dict[str, Any]], parameter_map: Dict[str, Any]) -> Dict[str, Any]: ...
    def inspect_dependencies(self) -> Dict[str, Any]: ...
    def bundle(self, destination: str) -> Dict[str, Any]: ...
    def run_checked(self, task_name: str, *, mode: str, expected_results: List[Dict[str, Any]], reuse: str = "never", note: str = "") -> Dict[str, Any]: ...

class CircuitResult:
    def __init__(self, path: str) -> None: ...
    def get_tree_items(self, *, task_name: Optional[str] = None) -> List[str]: ...
    def get_run_ids(self, tree_path: str) -> List[int]: ...
    def get_parameter_combination(self, run_id: int) -> Dict[str, Any]: ...
    def read_curve(self, tree_path: str, *, run_id: int) -> Dict[str, Any]: ...
    def export_csv(self, tree_path: str, destination: str, *, run_id: int) -> Dict[str, Any]: ...
